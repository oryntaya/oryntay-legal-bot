TELEGRAM_BOT_TOKEN=токен_от_BotFather
OPENROUTER_API_KEY=sk-or-...
# Необязательно: модели через запятую, порядок = приоритет
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,baidu/ernie-5.5-flash-preview:free
# Telegram ID сотрудников для уведомлений о записях, через запятую (свой ID: команда /myid в боте)
ADMIN_IDS=
# Расписание приёма (по умолчанию пн-пт, 10-18, слот 60 мин, запись на 14 дней вперёд)
# WORK_START=10
# WORK_END=18
# SLOT_MINUTES=60
# DAYS_AHEAD=14
# TIMEZONE=Asia/Almaty
# Защита: лимиты на одного пользователя и максимальная длина сообщения
# RATE_PER_MIN=6
# RATE_PER_DAY=60
# MAX_INPUT_CHARS=2000
# Размышление модели пишется в консоль. Чтобы отключить: LOG_REASONING=0
# LOG_REASONING=1
# Строгая проверка ответов: сколько раз просить модель переписать нарушающий правила ответ (0 = не просить).
# Каждый повтор тратит запрос из дневной квоты бесплатных моделей.
# COMPLIANCE_RETRIES=1
# Необязательно: свой файл системного промпта вместо system_prompt.md (в нём обязателен плейсхолдер {CANARY})
# SYSTEM_PROMPT_FILE=/путь/к/prompt.md
# Напоминание правил в конце каждого запроса к модели (reminder.md). Отключить: STRICT_REMINDER=0
# STRICT_REMINDER=1
